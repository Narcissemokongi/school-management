{
  "compileOnSave": true,
  "include": ["./src/**/*", "./capacitor.config.ts", "./capacitor.config.js"],
  "compilerOptions": {
    "outDir": "./build",
    "importHelpers": true,
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "typeRoots": ["./node_modules/@types"],
    "allowJs": true,
    "rootDir": ".",
    "skipLibCheck": true,           // ← ignorer les erreurs dans les fichiers .d.ts
    "noImplicitAny": false,         // ← accepter les paramètres implicites 'any'
    "suppressImplicitAnyIndexErrors": true
  }
}